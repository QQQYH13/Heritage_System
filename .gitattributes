# 统一换行符，避免 Windows / Linux / Mac 协作时出现 CRLF/LF 冲突
* text=auto

# 文本文件统一使用 LF
*.java text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.vue  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.properties text eol=lf

# Windows 批处理脚本使用 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.jar  binary
*.zip  binary
*.mp4  binary
